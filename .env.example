# Handelo API bind/port. Keep the API on loopback behind the production HTTPS reverse proxy.
PORT=8787
HOST=127.0.0.1

# Handelo AI provider. Groq/OpenAI/Anthropic keys are detected automatically.
HANDELO_API_KEY=
# Required in production for all non-public API routes; share only with the server-side Vercel proxy.
HANDELO_CLIENT_API_KEY=

# Binance Web3 market data / execution infrastructure
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional BSC RPC for direct chain verification
BSC_RPC_URL=

# Optional demo wallet address (never put a private key here)
HANDELO_WALLET=

# Keep false unless running a controlled live demo with an authenticated Agentic Wallet.
HANDELO_EXECUTION_ENABLED=false

# Optional Telegram bot; obtain the token from BotFather and keep it secret.
TELEGRAM_BOT_TOKEN=
# Telegram's Handelo API destination; on the VPS use http://127.0.0.1:8787.
HANDELO_API_URL=http://127.0.0.1:8787

# Read-only MCP HTTP connector for Claude.ai; generate a random 32+ character key and keep it secret.
HANDELO_MCP_API_KEY=
HANDELO_MCP_PORT=8789
HANDELO_MCP_ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai

# Optional strategy-state persistence overrides for a VPS deployment.
# HANDELO_STRATEGY_STORE_PATH=/opt/handelo/data/strategies.json
# HANDELO_STRATEGY_EXECUTION_STORE_PATH=/opt/handelo/data/strategy-executions.json
# Optional CORS origin of the deployed Handelo frontend; use the exact origin without a trailing slash.
# HANDELO_CORS_ORIGIN=https://your-frontend.example
# Keep the autonomous strategy runtime off until controlled execution has been validated.
# HANDELO_STRATEGY_WORKER_ENABLED=false

# Remote MCP authentication: fixed API key or OAuth for Claude's browser connector.
HANDELO_MCP_AUTH_MODE=api-key
# OAuth requires a public HTTPS origin with no trailing slash.
# HANDELO_OAUTH_ISSUER=https://your-mcp-host.example
# Keep a dedicated login username/password private; password must be at least 16 characters.
# HANDELO_OAUTH_USERNAME=
# HANDELO_OAUTH_PASSWORD=
# HMAC key for signed OAuth access tokens; generate on the VPS with openssl rand -hex 32.
# HANDELO_OAUTH_TOKEN_SECRET=
# Persists dynamically registered clients and hashed refresh token records.
# HANDELO_OAUTH_STORE_PATH=/opt/handelo/data/oauth-state.json
